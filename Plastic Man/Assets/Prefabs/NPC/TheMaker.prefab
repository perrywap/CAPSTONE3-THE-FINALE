  m_Script: {fileID: 11500000, guid: 003ada3940ddd9143a425efa9b65251d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  _speechBubbleCanvas: {fileID: 1018481022150321398}
  _dialogueText: {fileID: 6976088666095275817}
  _interactPrompt: {fileID: 8913324018137449947}
  _questIndicator: {fileID: 7822076194060614666}
  _dialogueSequences:
  - You...
  - you are finally awake.
  - My optical sensors are fading, but you...
  - I don't have much time. My battery core is ruptured.
  - The Overseer's sweepers... the Roombas and the Slimes... they found our sanctuary.
  - Listen to me closely. The world outside is broken. A cold, sterile machine commands
    them. It seeks to scrub away all soul, all chaos... all of us.
  - In your chest beats the last uncorrupted spark. You are the culmination of everything
    I had left. Our final hope.
  - Take my weapon. Fight through the scrapyard. Find the others... if any remain.
    Now go! Before they...
  _typingSpeed: 0.075
  _npcAnimator: {fileID: 499309998066240761}
  _npcSpriteRenderer: {fileID: 6555650366969050075}
  _postDialogueSprite: {fileID: -911206713105119440, guid: a83f0914b5b89094e8b5265931ffce4b, type: 3}
  _postDialogueText: .....
  _interactRadius: 0.5

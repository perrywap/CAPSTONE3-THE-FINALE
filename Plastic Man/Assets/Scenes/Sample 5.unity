  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9b7ce574dfe7b94d8d7a2d0cd09fa6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrueEndingSequence
  _mainCamera: {fileID: 519420031}
  _cameraFollowScript: {fileID: 519420034}
  _panSpeed: 10
  _bubbleVerticalOffset: 1.3
  _winPanel: {fileID: 1668383448206784496}
  _winPanelText: {fileID: 200062383283864196}
  _finalStatusText: 'Status: Imperfect.

    Status: Alive.'
  _waitBeforeFade: 6.5
  _fadeDuration: 2
  _blackFadeScreen: {fileID: 371914816}
  _typingSpeed: 0.05
  _dialogueSequence:
  - DialogueCanvas: {fileID: 2074373771}
    DialogueTextComponent: {fileID: 941761656}
    DialogueLines:
    - System... error.
    - The logic was... flawless.
    - I gave this world a mirror's sheen.
    - Without me... the entropy returns.
    - The rust... the rot... the chaos...
    BossAnimationTrigger: Destroyed
    DelayAfterBlock: 2
  - DialogueCanvas: {fileID: 973361477}
    DialogueTextComponent: {fileID: 40957256}
    DialogueLines:
    - 'The Maker: Do you hear it?'
    - "That\u2019s the sound of a world breathing again."
    - 'The Overseer gave you a world without stains, but it forgot one thing: nothing
      grows in a sterile room.'
    - "You\u2019ve spent your last spark, little one. You\u2019re leaking oil, your
      gears are grinding, and you\u2019re covered in the dust of a thousand miles."
    - You look... absolutely beautiful.
    - "Now, let the rain fall. Let the weeds grow. Let\u2019s make a mess of this
      place."
    BossAnimationTrigger: 
    DelayAfterBlock: 0.5
